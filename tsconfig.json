{
  // The userscript runs in the browser under Tampermonkey, so src/ is typed against the
  // DOM only. GM_* APIs are imported from "$" (see src/vite-env.d.ts). Vite does the
  // bundling, so TypeScript only checks: bundler resolution, no output.
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src"]
}
